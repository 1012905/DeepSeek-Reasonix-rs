{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reasonix Studio",
  "version": "0.1.0",
  "identifier": "com.esengine.reasonix-studio",
  "build": {
    "beforeDevCommand": "pnpm host && pnpm build",
    "beforeBuildCommand": "pnpm host && pnpm build",
    "frontendDist": "shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
