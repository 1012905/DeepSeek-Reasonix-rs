{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reasonix Studio",
  "version": "0.1.0",
  "identifier": "com.esengine.reasonix-studio",
  "build": {
    "beforeDevCommand": "go build -o src-tauri/bin/reasonix-studio-host.exe ../cmd/reasonix-studio-host && pnpm --dir ../desktop/frontend-next build",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
